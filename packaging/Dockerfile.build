# Native builds must run on the fleet's glibc 2.31 machines. AlmaLinux 8
# provides a maintained glibc 2.28 toolchain (security support through 2029).
# Keep CPython on 3.11, using Astral's portable runtime with current bundled
# OpenSSL/zlib/Expat instead of the retired python:3.11-bullseye image.
# Upstream release asset digests: astral-sh/python-build-standalone/20261021.
ARG TARGETARCH
FROM scratch AS python-amd64
ADD --checksum=sha256:7cc8d9dce9ea23c31267e7f244005c8979da04794b7737a3a30e62b03abeb120 https://github.com/astral-sh/python-build-standalone/releases/download/20261021/cpython-3.11.17%2B20261021-x86_64-unknown-linux-gnu-install_only.tar.gz /python.tar.gz

FROM scratch AS python-arm64
ADD --checksum=sha256:c9af9f30e2cd74dbb9dfcc29cde4e966489692522c82a22d4a2bce79dce0e349 https://github.com/astral-sh/python-build-standalone/releases/download/20261021/cpython-3.11.17%2B20261021-aarch64-unknown-linux-gnu-install_only.tar.gz /python.tar.gz

FROM python-${TARGETARCH} AS python-runtime

FROM scratch AS packages-common
ADD --checksum=sha256:fd7f4dfa8190e014013b9f08f3e973f4e4c26ffd179a204895533a7254813a70 https://files.pythonhosted.org/packages/3f/06/3e4420302363fbb71be3c7f35ce042f54bfca330e3e66b3a2e3c4cca579f/pip-26.2.2-py3-none-any.whl /wheels/pip-26.2.2-py3-none-any.whl
