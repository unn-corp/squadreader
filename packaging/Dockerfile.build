ADD --checksum=sha256:3311ed60d36f83378794e1009ac6258bafbf81f7888b4caa7b35a521e3f95813 https://files.pythonhosted.org/packages/ad/66/c19feabb28485b6e0bbaaafa90837a1ef5d302e90f2178bd33f17a49879b/cffi-2.1.1-cp311-cp311-manylinux2014_aarch64.manylinux_2_17_aarch64.whl /wheels/cffi-2.1.1-cp311-cp311-manylinux2014_aarch64.manylinux_2_17_aarch64.whl
ADD --checksum=sha256:0ab0a9c4ffb1a6d95ef519fe4247dba8eb6b18ad93999f76b7f657039acabd47 https://files.pythonhosted.org/packages/33/a8/6fa8c1a345a8c85dbb21932c447bee07c30a2c2a3f31e369c0a84b300147/numpy-2.4.6-cp311-cp311-manylinux_2_27_aarch64.manylinux_2_28_aarch64.whl /wheels/numpy-2.4.6-cp311-cp311-manylinux_2_27_aarch64.manylinux_2_28_aarch64.whl

FROM packages-${TARGETARCH} AS packages

FROM almalinux:8.10@sha256:8b469a3a78515e8a18ea8fc727e6a3679e1d0c5ba6f58d5b30be3d0d9b86cffe
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/opt/python/bin:${PATH}"

# Only native compilation tools; no image/media stack or extra interpreters.
# RPM signatures remain required by the distribution's package manager.
RUN dnf -y upgrade \
    && dnf -y install gcc gcc-c++ libatomic-static make tar gzip \
    && dnf clean all
COPY --from=python-runtime /python.tar.gz /tmp/python.tar.gz
RUN tar -xzf /tmp/python.tar.gz -C /opt && rm /tmp/python.tar.gz

# All Python inputs are hash-verified above. Install without network or index
# access: pip's vendored HTTP clients never parse index/download responses.
COPY --from=packages /wheels /wheels
RUN --network=none python3 -m pip install --no-index --no-deps /wheels/pip-26.2.2-py3-none-any.whl \
    && python3 -m pip install --no-index --no-deps --find-links=/wheels \
        "setuptools==84.2.1" "wheel==0.48.0" "packaging==26.3" \
    && python3 -m pip install --no-index --no-deps --find-links=/wheels \
        --no-build-isolation --report=/opt/sqreader-build-install.json \
        "nuitka==4.3.1" "ordered-set==4.1.0" "patchelf==0.19.1.0" \
        "zstandard==0.25.0" "cryptography==50.0.2" "cffi==2.1.1" \
        "pycparser==3.12" "numpy==2.4.6" "certifi==2026.10.23" \
    && python3 -m pip check \
    && rm -rf /wheels

WORKDIR /src
ENTRYPOINT ["/bin/bash"]
